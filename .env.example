# Firebase client config (public — safe to expose, restricted by Firestore rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin allowlist — comma separated Google account emails allowed into /admin
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com

# Used later (Phase 3) for Telegram/Discord notifications, called from Firestore-triggered
# Cloud Functions or an API route — never expose bot tokens with NEXT_PUBLIC_
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
