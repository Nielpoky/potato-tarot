rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /qris/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email in ["you@example.com"];
    }
    match /selfies/{fileName} {
      allow read, write: if request.auth != null &&
        request.auth.token.email in ["you@example.com"];
    }
  }
}
